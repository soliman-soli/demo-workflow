    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "={{ $env.WHATSAPP_PHONE_NUMBER_ID }}",
        "recipientPhoneNumber": "={{ $('Route Request').first().json.from }}",
        "textBody": "={{ $('Route Request').first().json.route_mode === 'auto_reserve' ? `Reserved for 2 hours (${$('Route Request').first().json.request_id}): ` + $('Route Request').first().json.matched.map(m => `${m.qty} x ${m.medicine.name} ${m.medicine.strength} = ${m.qty * m.medicine.price_egp} EGP`).join(', ') + '. Pick up from the pharmacy.' : 'Our pharmacist is reviewing your request and will confirm shortly.\\nيقوم الصيدلي بمراجعة طلبك الآن وسيتم تأكيده خلال لحظات.' }}"
      },
      "id": "reply-whatsapp",
      "name": "Reply WhatsApp",
