    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_PHARMACISTS_CHAT_ID }}",
        "text": "={{ `Request ${$('Route Request').first().json.request_id}\\nCustomer: ${$('Route Request').first().json.customer}\\n` + $('Route Request').first().json.matched.map(m => `• ${m.qty} x ${m.medicine.name} ${m.medicine.strength} (${m.in_stock ? 'in stock' : 'OUT OF STOCK' + (m.alternative ? ' · Alt: ' + m.alternative.name + ' ' + m.alternative.id + ' ' + m.alternative.price_egp + ' EGP' : '')})`).join('\\n') }}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "Approve",
                    "additionalFields": {
                      "callback_data": "={{ `ph:approve:${$('Route Request').first().json.request_id}` }}"
                    }
                  },
                  {
                    "text": "Reject",
                    "additionalFields": {
                      "callback_data": "={{ `ph:reject:${$('Route Request').first().json.request_id}` }}"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "id": "post-telegram-card",
      "name": "Post Telegram Card",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2680,
        440
      ],
      "credentials": {
        "telegramApi": {
          "id": "dawaa-telegram-bot",
