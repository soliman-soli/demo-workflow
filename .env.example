# n8n webhook base URL (no trailing slash)
N8N_BASE_URL=https://your-n8n-host/webhook
N8N_WEBHOOK_KEY=your-api-key-here

# Passcode for the HR recruiter dashboard
HR_DEMO_PASSCODE=demo-recruiter-2024

# Set to "true" to use mock data (no n8n needed)
USE_MOCKS=false

# Optional: Cloudflare Turnstile (bot protection on Apply and Coach forms)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: Upstash Redis for rate limiting (falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

