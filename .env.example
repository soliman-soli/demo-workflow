# HR Demo n8n webhook base URL (no trailing slash)
N8N_BASE_URL=https://your-n8n-host/webhook
N8N_WEBHOOK_KEY=your-api-key-here

# Dawaa Pharmacy n8n webhook base URL & secret (Header: X-API-KEY)
N8N_PHARMACY_BASE_URL=
N8N_SECRET=

# Fenjan Café · Order by DM (optional overrides — defaults automatically to N8N_BASE_URL + /fenjan-*)
FENJAN_PORTAL_URL=
FENJAN_STATUS_URL=
FENJAN_SPECIALS_URL=
# Optional public link to the Fenjan kitchen update form (omitted if empty)
NEXT_PUBLIC_FENJAN_KITCHEN_FORM_URL=

# Mozakra · AI Study Coach (uses N8N_BASE_URL + x-api-key header; server-only)
N8N_MOZAKRA_KEY=

# Passcode for the HR recruiter dashboard
HR_DEMO_PASSCODE=demo-recruiter-2024

# Set to "true" to use mock data (no n8n needed)
USE_MOCKS=false

# Optional: Cloudflare Turnstile (bot protection on Apply and Coach forms)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: Upstash Redis for rate limiting (falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

